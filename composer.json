{
    "name": "corpuscom/blost-bundle",
    "description": "Native Blost publishing integration for Symfony and Laravel",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/config": "^12.0 || ^13.0",
        "laravel/framework": "^12.0 || ^13.0",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "suggest": {
        "symfony/framework-bundle": "Required for Symfony integration",
        "illuminate/support": "Required for Laravel integration",
        "illuminate/routing": "Required for Laravel integration"
    },
    "autoload": {
        "psr-4": {
            "Corpuscom\\Blost\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Corpuscom\\Blost\\Tests\\": "tests/",
            "Corpuscom\\Blost\\LaravelBlog\\": "packages/laravel/src/",
            "Corpuscom\\Blost\\SymfonyBlog\\": "packages/symfony/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Corpuscom\\Blost\\Laravel\\BlostServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@composer validate --strict packages/laravel/composer.json",
            "@composer validate --strict packages/symfony/composer.json",
            "@cs-check",
            "@test"
        ],
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
